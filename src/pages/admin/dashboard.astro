---
import themeConfig from '@theme-config'
import AdminSectionNav from '@components/admin/AdminSectionNav.astro'
import ProductivityDashboardScript from '@components/admin/scripts/ProductivityDashboardScript.astro'

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? ''
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? ''
const rawAdminIdleTimeoutMinutes = Number.parseInt(import.meta.env.PUBLIC_ADMIN_IDLE_TIMEOUT_MINUTES ?? '20', 10)
const adminIdleTimeoutMinutes = Number.isFinite(rawAdminIdleTimeoutMinutes)
  ? Math.min(30, Math.max(15, rawAdminIdleTimeoutMinutes))
  : 20
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Admin - Productivity Dashboard</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style
      is:global
      define:vars={{
        brandPrimary: themeConfig.colors.primary,
        brandSecondary: themeConfig.colors.secondary,
        brandNeutral: themeConfig.colors.neutral,
        brandOutline: themeConfig.colors.outline,
      }}
    >
      :root {
        color-scheme: light dark;
        --brand-primary: var(--brandPrimary);
        --brand-secondary: var(--brandSecondary);
        --brand-neutral: var(--brandNeutral);
        --brand-outline: var(--brandOutline);
        --text-color: light-dark(#1f2530, #f8f9fc);
        --surface: light-dark(rgba(255, 255, 255, 0.8), rgba(20, 24, 30, 0.9));
        --surface-soft: light-dark(rgba(247, 250, 253, 0.88), rgba(32, 37, 44, 0.9));
        --border-soft: light-dark(rgba(31, 37, 48, 0.14), rgba(244, 247, 250, 0.15));
        --status-info: #2f6fd8;
        --status-success: #16803d;
        --status-error: #b42318;
        --shadow-lg: 0 24px 54px rgba(7, 12, 18, 0.18);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background:
          radial-gradient(
            circle at 0% -12%,
            color-mix(in oklab, var(--brand-primary) 34%, transparent),
            transparent 38%
          ),
          radial-gradient(
            circle at 100% -8%,
            color-mix(in oklab, var(--brand-secondary) 28%, transparent),
            transparent 35%
          ),
          linear-gradient(160deg, light-dark(#f8f9fd, #0f1318), light-dark(#edf1f7, #141a21));
        min-height: 100vh;
        color: var(--text-color);
        line-height: 1.55;
        font-family:
          Atkinson Hyperlegible,
          ui-sans-serif,
          system-ui,
          -apple-system,
          sans-serif;
      }

      body::before {
        position: fixed;
        opacity: 0.23;
        inset: 0;
        background-image:
          linear-gradient(to right, color-mix(in oklab, var(--brand-neutral) 30%, transparent) 1px, transparent 1px),
          linear-gradient(to bottom, color-mix(in oklab, var(--brand-neutral) 30%, transparent) 1px, transparent 1px);
        background-size: 24px 24px;
        pointer-events: none;
        content: '';
      }

      .admin-shell {
        position: relative;
        margin-inline: auto;
        padding: clamp(1rem, 2.8vw, 2rem);
        max-width: 1320px;
      }

      .panel {
        backdrop-filter: blur(10px);
        box-shadow: var(--shadow-lg);
        border: 1px solid var(--border-soft);
        border-radius: 20px;
        background: var(--surface);
      }

      .admin-header {
        display: grid;
        gap: 1rem;
        padding: clamp(1rem, 2.6vw, 1.5rem);
      }

      .eyebrow,
      h1,
      h2,
      h3,
      p {
        margin: 0;
      }

      .eyebrow {
        color: color-mix(in oklab, var(--text-color) 70%, transparent);
        font-weight: 700;
        font-size: 0.82rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      h1 {
        margin-top: 0.35rem;
        font-size: clamp(1.55rem, 3.6vw, 2.3rem);
        line-height: 1.15;
      }

      .lead {
        margin-top: 0.38rem;
        max-width: 64ch;
        color: color-mix(in oklab, var(--text-color) 78%, transparent);
      }

      .header-actions,
      .form-actions,
      .toolbar,
      .item-actions,
      .focus-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
      }

      .link-chip,
      .button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        gap: 0.35rem;
        transition:
          transform 140ms ease,
          box-shadow 200ms ease,
          border-color 160ms ease,
          background-color 160ms ease;
        cursor: pointer;
        border: 1px solid var(--border-soft);
        border-radius: 12px;
        background: color-mix(in oklab, var(--surface-soft) 82%, transparent);
        padding: 0.62rem 0.85rem;
        color: inherit;
        font: inherit;
        font-weight: 700;
        text-decoration: none;
      }

      .link-chip:hover,
      .button:hover {
        transform: translateY(-1px);
        border-color: color-mix(in oklab, var(--brand-primary) 36%, var(--border-soft));
        background: color-mix(in oklab, var(--surface-soft) 62%, var(--brand-primary) 16%);
      }

      .button.primary {
        border-color: color-mix(in oklab, var(--brand-primary) 35%, var(--border-soft));
        background: linear-gradient(
          140deg,
          color-mix(in oklab, var(--brand-primary) 20%, var(--surface-soft)),
          color-mix(in oklab, var(--brand-secondary) 14%, var(--surface-soft))
        );
      }

      .button.small {
        padding: 0.45rem 0.72rem;
        font-size: 0.92rem;
      }

      .button.danger {
        border-color: color-mix(in oklab, var(--status-error) 38%, var(--border-soft));
      }

      .button:focus-visible,
      .link-chip:focus-visible,
      input:focus-visible,
      textarea:focus-visible,
      select:focus-visible {
        outline: 2px solid transparent;
        box-shadow: 0 0 0 3px color-mix(in oklab, var(--brand-outline) 28%, transparent);
      }

      .button[disabled] {
        transform: none;
        opacity: 0.6;
        cursor: not-allowed;
      }

      .admin-section-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.6rem;
        margin: 1rem 0;
        padding: clamp(0.8rem, 2vw, 1rem);
      }

      .nav-link.is-active {
        border-color: color-mix(in oklab, var(--brand-primary) 45%, var(--border-soft));
        background: linear-gradient(
          145deg,
          color-mix(in oklab, var(--brand-primary) 22%, var(--surface-soft)),
          color-mix(in oklab, var(--brand-secondary) 14%, var(--surface-soft))
        );
      }

      .status {
        margin: 1rem 0;
        border: 1px solid var(--border-soft);
        border-radius: 12px;
        background: color-mix(in oklab, var(--surface-soft) 88%, transparent);
        padding: 0.72rem 0.85rem;
      }

      .status.info {
        border-color: color-mix(in oklab, var(--status-info) 52%, var(--border-soft));
      }

      .status.success {
        border-color: color-mix(in oklab, var(--status-success) 52%, var(--border-soft));
      }

      .status.error {
        border-color: color-mix(in oklab, var(--status-error) 52%, var(--border-soft));
      }

      body[data-admin-auth-pending='true'] .admin-header,
      body[data-admin-auth-pending='true'] .admin-section-nav,
      body[data-admin-auth-pending='true'] #app-section {
        display: none !important;
      }

      body[data-admin-auth-pending='true'] #status {
        margin-top: clamp(18vh, 24vh, 28vh);
      }

      .dashboard-grid {
        display: grid;
        gap: 1rem;
      }

      .panel-card {
        padding: clamp(1rem, 2.4vw, 1.35rem);
      }

      .panel-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 0.8rem;
        margin-bottom: 0.95rem;
      }

      .panel-head p,
      .muted {
        color: color-mix(in oklab, var(--text-color) 74%, transparent);
      }

      .metrics {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(145px, 1fr));
        gap: 0.65rem;
        margin-bottom: 1rem;
      }

      .metric {
        border: 1px solid var(--border-soft);
        border-radius: 16px;
        background: color-mix(in oklab, var(--surface-soft) 76%, transparent);
        padding: 0.72rem 0.78rem;
      }

      .metric p {
        color: color-mix(in oklab, var(--text-color) 72%, transparent);
        font-size: 0.84rem;
      }

      .metric strong {
        display: block;
        margin-top: 0.2rem;
        font-size: 1.38rem;
        line-height: 1.1;
      }

      .field-grid {
        display: grid;
        gap: 0.75rem;
      }

      .field-grid.two {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }

      .field {
        display: grid;
        gap: 0.35rem;
      }

      .field label {
        font-weight: 700;
        font-size: 0.95rem;
      }

      input,
      textarea,
      select {
        transition:
          border-color 140ms ease,
          box-shadow 190ms ease;
        border: 1px solid var(--border-soft);
        border-radius: 12px;
        background: color-mix(in oklab, var(--surface-soft) 82%, transparent);
        padding: 0.72rem 0.86rem;
        width: 100%;
        color: inherit;
        font: inherit;
      }

      textarea {
        min-height: 112px;
        resize: vertical;
      }

      .helper {
        border: 1px dashed var(--border-soft);
        border-radius: 12px;
        background: color-mix(in oklab, var(--surface-soft) 72%, transparent);
        padding: 0.65rem 0.75rem;
        color: color-mix(in oklab, var(--text-color) 76%, transparent);
        font-size: 0.92rem;
      }

      .item-list {
        display: grid;
        gap: 0.65rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .item {
        display: grid;
        gap: 0.55rem;
        border: 1px solid var(--border-soft);
        border-radius: 16px;
        background: color-mix(in oklab, var(--surface-soft) 74%, transparent);
        padding: 0.8rem;
      }

      .item.is-done {
        opacity: 0.72;
      }

      .item-main {
        display: grid;
        gap: 0.25rem;
      }

      .item-title {
        font-weight: 800;
      }

      .item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.35rem;
        color: color-mix(in oklab, var(--text-color) 72%, transparent);
        font-size: 0.86rem;
      }

      .pill {
        border: 1px solid var(--border-soft);
        border-radius: 999px;
        background: color-mix(in oklab, var(--surface-soft) 70%, transparent);
        padding: 0.1rem 0.48rem;
      }

      .priority-high {
        border-color: color-mix(in oklab, var(--status-error) 42%, var(--border-soft));
      }

      .priority-medium {
        border-color: color-mix(in oklab, var(--brand-primary) 42%, var(--border-soft));
      }

      .priority-low {
        border-color: color-mix(in oklab, var(--brand-secondary) 42%, var(--border-soft));
      }

      .empty-state {
        border: 1px dashed var(--border-soft);
        border-radius: 14px;
        background: color-mix(in oklab, var(--surface-soft) 70%, transparent);
        padding: 0.9rem;
      }

      .focus-time {
        font-variant-numeric: tabular-nums;
        font-size: clamp(2.5rem, 11vw, 5.2rem);
        font-weight: 900;
        line-height: 1;
        letter-spacing: 0;
      }

      .focus-panel {
        display: grid;
        gap: 1rem;
      }

      .quick-note {
        min-height: 220px;
      }

      .sr-only {
        position: absolute;
        margin: -1px;
        padding: 0;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        border: 0;
        white-space: nowrap;
      }

      @media (min-width: 980px) {
        .admin-header {
          grid-template-columns: 1fr auto;
          align-items: center;
        }

        .dashboard-grid {
          grid-template-columns: minmax(310px, 0.9fr) minmax(420px, 1.15fr);
          align-items: start;
        }

        .wide-panel {
          grid-column: 1 / -1;
        }
      }

      @media (max-width: 720px) {
        .header-actions,
        .form-actions,
        .toolbar,
        .item-actions,
        .focus-actions {
          inline-size: 100%;
        }

        .header-actions .button,
        .header-actions .link-chip,
        .form-actions .button,
        .toolbar .button,
        .item-actions .button,
        .focus-actions .button {
          flex: 1 1 140px;
        }

        .panel-head {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body
    data-admin-auth-pending="true"
    data-supabase-url={supabaseUrl}
    data-supabase-anon-key={supabaseAnonKey}
    data-admin-idle-timeout-minutes={adminIdleTimeoutMinutes}
  >
    <main class="admin-shell">
      <header class="panel admin-header">
        <div>
          <p class="eyebrow">Ibnu Rizal Mutaqim CMS</p>
          <h1>Productivity Dashboard</h1>
          <p class="lead">Ruang kerja harian untuk task, jadwal, catatan cepat, dan sesi fokus.</p>
        </div>
        <div class="header-actions">
          <a class="link-chip" href="/">Preview website</a>
          <button class="button" id="export-button" type="button">Export data</button>
          <button class="button" id="import-button" type="button">Import data</button>
          <input class="sr-only" id="import-input" type="file" accept="application/json,.json" />
          <button class="button" id="logout-button" type="button">Sign out</button>
        </div>
      </header>

      <AdminSectionNav active="dashboard" />

      <div class="status info" id="status" role="status" aria-live="polite">Initializing...</div>

      <section id="app-section" hidden>
        <section class="metrics" aria-live="polite">
          <article class="metric">
            <p>Open tasks</p>
            <strong id="metric-open-tasks">0</strong>
          </article>
          <article class="metric">
            <p>Due today</p>
            <strong id="metric-due-today">0</strong>
          </article>
          <article class="metric">
            <p>Events today</p>
            <strong id="metric-events-today">0</strong>
          </article>
          <article class="metric">
            <p>Focus minutes</p>
            <strong id="metric-focus-minutes">0</strong>
          </article>
        </section>

        <div class="dashboard-grid">
          <section class="panel panel-card" aria-labelledby="task-form-title">
            <div class="panel-head">
              <div>
                <h2 id="task-form-title">Tambah Task</h2>
                <p>Masukkan hal yang perlu diselesaikan dan prioritasnya.</p>
              </div>
            </div>

            <form id="task-form" class="field-grid">
              <div class="field">
                <label for="task-title">Task</label>
                <input id="task-title" type="text" placeholder="Contoh: revisi portfolio section" required />
              </div>
              <div class="field-grid two">
                <div class="field">
                  <label for="task-category">Kategori</label>
                  <input id="task-category" type="text" placeholder="kuliah, project, pribadi" />
                </div>
                <div class="field">
                  <label for="task-priority">Prioritas</label>
                  <select id="task-priority">
                    <option value="high">High</option>
                    <option value="medium" selected>Medium</option>
                    <option value="low">Low</option>
                  </select>
                </div>
              </div>
              <div class="field-grid two">
                <div class="field">
                  <label for="task-due-date">Deadline</label>
                  <input id="task-due-date" type="date" />
                </div>
                <div class="field">
                  <label for="task-estimate">Estimasi menit</label>
                  <input id="task-estimate" type="number" min="5" step="5" placeholder="30" />
                </div>
              </div>
              <div class="form-actions">
                <button class="button primary" type="submit">Add task</button>
                <button class="button" id="clear-done-button" type="button">Clear done</button>
              </div>
            </form>
          </section>

          <section class="panel panel-card" aria-labelledby="task-list-title">
            <div class="panel-head">
              <div>
                <h2 id="task-list-title">Task Hari Ini</h2>
                <p>Checklist kerja harian, urut dari prioritas dan deadline.</p>
              </div>
              <div class="toolbar">
                <button class="button small" data-task-filter="all" type="button">All</button>
                <button class="button small" data-task-filter="open" type="button">Open</button>
                <button class="button small" data-task-filter="done" type="button">Done</button>
              </div>
            </div>
            <ul class="item-list" id="task-list"></ul>
          </section>

          <section class="panel panel-card" aria-labelledby="schedule-title">
            <div class="panel-head">
              <div>
                <h2 id="schedule-title">Jadwal</h2>
                <p>Agenda ringan untuk kuliah, organisasi, project, dan kegiatan pribadi.</p>
              </div>
            </div>

            <form id="schedule-form" class="field-grid">
              <div class="field">
                <label for="event-title">Kegiatan</label>
                <input id="event-title" type="text" placeholder="Contoh: meeting project website" required />
              </div>
              <div class="field-grid two">
                <div class="field">
                  <label for="event-date">Tanggal</label>
                  <input id="event-date" type="date" required />
                </div>
                <div class="field">
                  <label for="event-time">Jam</label>
                  <input id="event-time" type="time" />
                </div>
              </div>
              <div class="field">
                <label for="event-category">Kategori</label>
                <input id="event-category" type="text" placeholder="kuliah, organisasi, magang" />
              </div>
              <div class="form-actions">
                <button class="button primary" type="submit">Add schedule</button>
              </div>
            </form>

            <ul class="item-list" id="schedule-list"></ul>
          </section>

          <section class="panel panel-card" aria-labelledby="focus-title">
            <div class="panel-head">
              <div>
                <h2 id="focus-title">Focus Mode</h2>
                <p>Timer sederhana untuk mengunci satu pekerjaan.</p>
              </div>
            </div>
            <div class="focus-panel">
              <div class="field">
                <label for="focus-task">Task aktif</label>
                <input id="focus-task" type="text" placeholder="Apa yang sedang dikerjakan?" />
              </div>
              <div class="field">
                <label for="focus-minutes">Durasi</label>
                <select id="focus-minutes">
                  <option value="15">15 menit</option>
                  <option value="25" selected>25 menit</option>
                  <option value="45">45 menit</option>
                  <option value="60">60 menit</option>
                </select>
              </div>
              <div class="focus-time" id="focus-time" aria-live="polite">25:00</div>
              <div class="focus-actions">
                <button class="button primary" id="focus-start-button" type="button">Start</button>
                <button class="button" id="focus-pause-button" type="button">Pause</button>
                <button class="button" id="focus-reset-button" type="button">Reset</button>
              </div>
            </div>
          </section>

          <section class="panel panel-card wide-panel" aria-labelledby="notes-title">
            <div class="panel-head">
              <div>
                <h2 id="notes-title">Quick Notes</h2>
                <p>Tempat menaruh ide, catatan meeting, atau draft konten cepat.</p>
              </div>
              <p class="muted" id="notes-saved-at">Not saved yet</p>
            </div>
            <div class="field">
              <label for="quick-note">Catatan</label>
              <textarea class="quick-note" id="quick-note" placeholder="Tulis ide atau catatan cepat di sini..."></textarea>
            </div>
            <p class="helper">Data dashboard ini tersimpan lokal di browser. Gunakan export/import untuk backup.</p>
          </section>
        </div>
      </section>
    </main>

    <ProductivityDashboardScript />
  </body>
</html>
