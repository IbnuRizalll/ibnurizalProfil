---
import { DarkMode } from 'accessible-astro-components'
import { Icon } from 'astro-icon/components'

type AdminSectionKey = 'dashboard' | 'about' | 'portfolio' | 'blog' | 'messages' | 'storage'

interface Props {
  active: AdminSectionKey
}

const { active } = Astro.props

const sections: Array<{ key: AdminSectionKey; href: string; label: string }> = [
  { key: 'dashboard', href: '/admin/dashboard', label: 'Productivity Dashboard' },
  { key: 'about', href: '/admin/about', label: 'Edit About Me' },
  { key: 'portfolio', href: '/admin/portfolio', label: 'Edit Portofolio/Pengalaman' },
  { key: 'blog', href: '/admin/blog', label: 'Edit Blog' },
  { key: 'messages', href: '/admin/messages', label: 'Contact Messages' },
  { key: 'storage', href: '/admin/storage', label: 'Storage Cleanup' },
]
---

<nav class="panel admin-section-nav" aria-label="Admin page navigation">
  {
    sections.map((section) => (
      <a
        class:list={['link-chip', 'nav-link', section.key === active && 'is-active']}
        href={section.href}
        aria-current={section.key === active ? 'page' : undefined}
      >
        {section.label}
      </a>
    ))
  }
  <DarkMode class="admin-theme-toggle" label="Ganti mode terang atau gelap">
    <Icon aria-hidden="true" name="lucide:moon" size="20" slot="light" />
    <Icon aria-hidden="true" name="lucide:sun" size="20" slot="dark" />
  </DarkMode>
</nav>

<style is:global>
  .admin-section-nav {
    min-inline-size: 0;
  }

  .admin-section-nav .nav-link {
    justify-content: center;
    min-inline-size: 0;
    max-inline-size: 100%;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .admin-section-nav .admin-theme-toggle {
    flex: 0 0 auto;
    align-self: center;
  }

  @media (max-width: 720px) {
    .admin-section-nav .nav-link {
      flex: 1 1 100%;
    }

    .admin-section-nav .admin-theme-toggle {
      flex: 1 1 100%;
    }
  }
</style>
