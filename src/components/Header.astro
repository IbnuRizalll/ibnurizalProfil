---
import Navigation from '@components/Navigation.astro'
import LauncherConfig from '@components/LauncherConfig.astro'
import { HighContrast, ReducedMotion, SkipLink } from 'accessible-astro-components'

/**
 * Header Component
 *
 * @description A component that displays the header of the website
 */
---

<header class="site-header">
  <SkipLink />
  <!-- Initialize preference components -->
  <div hidden>
    <HighContrast />
    <ReducedMotion />
  </div>

  <Navigation />
  {/* To remove the launcher, delete this component and remove the LauncherTrigger from `Navigation.astro`. */}
  <LauncherConfig />
</header>

<script>
  declare global {
    interface Window {
      __siteHeaderCleanup?: (() => void) | undefined
      __siteHeaderListenerBound?: boolean | undefined
    }
  }

  const initSiteHeaderOffset = () => {
    if (typeof window === 'undefined') return

    if (typeof window.__siteHeaderCleanup === 'function') {
      window.__siteHeaderCleanup()
      window.__siteHeaderCleanup = undefined
    }

    const header = document.querySelector<HTMLElement>('.site-header')
    if (!(header instanceof HTMLElement)) return

    const root = document.documentElement
    let rafId = 0

    const syncOffset = () => {
      rafId = 0
      const nextOffset = Math.max(72, Math.ceil(header.getBoundingClientRect().height))
      root.style.setProperty('--site-header-offset', `${nextOffset}px`)
    }

    const queueSync = () => {
      if (rafId) return
      rafId = window.requestAnimationFrame(syncOffset)
    }

    queueSync()

    const resizeObserver = typeof ResizeObserver !== 'undefined' ? new ResizeObserver(queueSync) : undefined
    resizeObserver?.observe(header)

    window.addEventListener('resize', queueSync, { passive: true })
    window.addEventListener('orientationchange', queueSync)

    if (document.fonts?.ready) {
      document.fonts.ready.then(queueSync).catch(() => {})
    }

    window.__siteHeaderCleanup = () => {
      if (rafId) {
        window.cancelAnimationFrame(rafId)
      }
      resizeObserver?.disconnect()
      window.removeEventListener('resize', queueSync)
      window.removeEventListener('orientationchange', queueSync)
    }
  }

  initSiteHeaderOffset()

  if (!window.__siteHeaderListenerBound) {
    document.addEventListener('astro:page-load', initSiteHeaderOffset)
    window.__siteHeaderListenerBound = true
  }
</script>

<style lang="scss" is:global>
  @use '@assets/scss/base/breakpoint' as *;

  :root {
    --site-header-offset: 5rem;
  }

  .site-header {
    position: fixed;
    z-index: 1300;
    inset-inline: 0;
    inset-block-start: 0;
    isolation: isolate;

    li.type-icon {
      display: block;

      @include breakpoint('nav') {
        translate: 0 4px;
      }

      > a,
      button {
        display: inline-flex;
        justify-content: center;
        align-items: center;
        transition:
          transform 220ms var(--cubic-bezier),
          border-color 220ms var(--cubic-bezier),
          background-color 220ms var(--cubic-bezier),
          box-shadow 220ms var(--cubic-bezier);
        box-shadow: 0 0 0 0 transparent;
        border: 1px solid transparent;
        border-radius: var(--radius-large);
        background: transparent;
        padding: 0.38rem;
        min-inline-size: 2.55rem;
        min-block-size: 2.55rem;
        text-decoration: none;
      }

      svg {
        inline-size: clamp(24px, 2.2vw, 30px);
        block-size: clamp(24px, 2.2vw, 30px);
      }

      > a svg,
      button svg {
        transition: transform 220ms var(--cubic-bezier);
      }

      > a:where(:hover, :focus-visible),
      &:focus-within button,
      button:where(:hover, :focus-visible) {
        transform: translateY(-1px);
        box-shadow: var(--elevation-2);
        border-color: color-mix(in oklab, var(--link-color) 45%, var(--border-color-subtle));
        background: color-mix(in oklab, var(--background-color) 84%, var(--color-secondary-200));
        text-decoration: none;
      }

      > a:where(:hover, :focus-visible) svg,
      &:focus-within button svg,
      button:where(:hover, :focus-visible) svg {
        transform: rotate(-8deg) scale(1.08);
      }

      > a:active,
      button:active {
        transform: translateY(0) scale(0.97);
        box-shadow: none;
      }

      > a:active svg,
      button:active svg {
        transform: rotate(8deg) scale(0.96);
      }
    }

    :is(li.type-icon, .mobile-theme-toggle).animate-rotate:where(:hover, :focus-visible, :focus-within) {
      animation: none;
    }

    @media (prefers-reduced-motion: reduce) {
      li.type-icon {
        > a,
        button,
        > a svg,
        button svg {
          transition: none;
        }

        > a:where(:hover, :focus-visible),
        &:focus-within button,
        button:where(:hover, :focus-visible),
        > a:where(:hover, :focus-visible) svg,
        &:focus-within button svg,
        button:where(:hover, :focus-visible) svg,
        > a:active,
        button:active,
        > a:active svg,
        button:active svg {
          transform: none;
        }
      }
    }

    li.type-icon ~ li.type-icon {
      @include breakpoint('nav') {
        margin-inline-start: calc(var(--space-2xs) * -1);
      }
    }

    li.desktop-launcher {
      display: none;
    }

    @include breakpoint('nav') {
      li.desktop-launcher {
        display: block;
      }
    }
  }
</style>
